# Database
DATABASE_URL=postgres://postgres:fluxmin_secret_2026@localhost:5432/fluxmin

# JWT
JWT_SECRET=fluxmin-jwt-secret-key-super-secure-2026
JWT_REFRESH_SECRET=fluxmin-jwt-refresh-secret-key-super-secure-2026

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=fluxmin-bucket
MINIO_USE_SSL=false
# MINIO_DISABLED=true

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_TASK_QUEUE=fluxmin
TEMPORAL_RELANCES_DELAY=3 days
TEMPORAL_ESCALADE_DELAY=2 days
# TEMPORAL_DISABLED=true
# TEMPORAL_WORKER_DISABLED=true

# Services
IA_SERVICE_URL=http://localhost:8000
GEO_SERVICE_URL=http://localhost:8001
# APILAYER_API_KEY=
# IPSTACK_ACCESS_KEY=

# App
SWAGGER_ENABLED=true
THROTTLE_TTL=60000
THROTTLE_LIMIT=60
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
PORT=3001
