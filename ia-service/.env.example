# auto = vendor/tesseract d'abord (portable), puis PATH, puis systeme, puis RapidOCR
TESSERACT_CMD=auto

# Cascade multi-LLM uniquement (pas de résumé NLP local)
LLM_ENABLED=true
# max | economy | balanced
LLM_STRATEGY=max
# Optionnel : groq,openai,anthropic,openrouter,gemini,xai,mistral
LLM_PROVIDER_ORDER=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_CHARS=12000

# GroqCloud — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

XAI_API_KEY=
XAI_MODEL=grok-2-1212

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
